# =====================================================================
#  MR BOX — las variables del servidor.
#
#  Copiá este archivo a `.env` y completá los valores ahí. El `.env` de
#  verdad NO se sube al repositorio (está en .gitignore).
#
#  REGLA: las claves se escriben acá, nunca en el código y nunca en un
#  chat. Si una clave se vio en algún lado, se rota y listo.
# =====================================================================

# ── La base ──────────────────────────────────────────────────────────
DATABASE_URI=mongodb://127.0.0.1:27017/mrbox_local
PORT=5001

# Con qué se firman las sesiones. Cualquier texto largo y al azar sirve;
# si cambia, se cierran todas las sesiones abiertas.
JWT_SECRET=

# ── Cloudflare Turnstile (el captcha) ────────────────────────────────
#  Se saca en dash.cloudflare.com → Turnstile → Add widget manually,
#  con el hostname mrbox.gg. Da dos claves:
#
#  - El SITE KEY es público: va en el HTML y se puede compartir.
#    Vive en el frontend (frontend/.env), no acá.
#  - El SECRET KEY es el que valida los tokens contra Cloudflare. Ese va
#    acá y no sale nunca del servidor.
TURNSTILE_SECRET_KEY=

# ── OxaPay (cobros y pagos en cripto) ────────────────────────────────
#  Del panel de merchant de oxapay.com.
#
#  MERCHANT: para cobrar, o sea crear la factura de cada depósito.
OXAPAY_MERCHANT_KEY=
#  PAYOUT: para pagar los canjes. Es la clave que mueve plata hacia
#  afuera, así que es la más delicada de todas las de este archivo.
OXAPAY_PAYOUT_KEY=
#  Lo que OxaPay firma en cada aviso de pago, para comprobar que el aviso
#  viene de ellos y no de alguien que descubrió la dirección.
OXAPAY_CALLBACK_SECRET=
#  La dirección a la que OxaPay avisa cuando un pago se confirma.
OXAPAY_CALLBACK_URL=https://mrbox.gg/api/payments/oxapay/callback
